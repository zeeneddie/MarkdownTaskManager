<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Evolution Performance Dashboard</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            color: #e0e0e0;
        }

        .header {
            background: rgba(255, 255, 255, 0.05);
            padding: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .header h1 {
            font-size: 24px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .nav a {
            color: #e0e0e0;
            text-decoration: none;
            padding: 8px 16px;
            background: rgba(255,255,255,0.1);
            border-radius: 6px;
            font-size: 14px;
            transition: all 0.2s;
            border: 1px solid rgba(255,255,255,0.1);
        }

        .nav a:hover {
            background: rgba(255,255,255,0.15);
            border-color: #4fc3f7;
        }

        .nav a.active {
            background: rgba(79, 195, 247, 0.2);
            border-color: #4fc3f7;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        /* Summary Cards */
        .summary-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .summary-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .summary-card .label {
            font-size: 12px;
            color: #888;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .summary-card .value {
            font-size: 28px;
            font-weight: 600;
            color: #4fc3f7;
        }

        .summary-card .trend {
            font-size: 12px;
            margin-top: 8px;
        }

        .trend.up { color: #4caf50; }
        .trend.down { color: #f44336; }
        .trend.stable { color: #ff9800; }

        /* Agent Grid */
        .agent-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 15px;
            margin-bottom: 30px;
        }

        .agent-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 15px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .agent-card:hover {
            transform: translateY(-2px);
            border-color: #4fc3f7;
        }

        .agent-card.selected {
            border-color: #4fc3f7;
            background: rgba(79, 195, 247, 0.1);
        }

        .agent-card .name {
            font-weight: 600;
            font-size: 16px;
            margin-bottom: 5px;
        }

        .agent-card .role {
            font-size: 11px;
            color: #888;
            margin-bottom: 10px;
        }

        .agent-card .improvement {
            font-size: 20px;
            font-weight: 600;
        }

        .improvement.positive { color: #4caf50; }
        .improvement.negative { color: #f44336; }
        .improvement.neutral { color: #ff9800; }

        /* Charts Section */
        .charts-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .chart-container {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .chart-container h3 {
            font-size: 14px;
            color: #888;
            margin-bottom: 15px;
        }

        .chart {
            height: 200px;
            display: flex;
            align-items: flex-end;
            gap: 10px;
        }

        .bar {
            flex: 1;
            background: linear-gradient(to top, #4fc3f7, #29b6f6);
            border-radius: 4px 4px 0 0;
            position: relative;
            min-height: 10px;
            transition: height 0.3s ease;
        }

        .bar:hover {
            background: linear-gradient(to top, #29b6f6, #03a9f4);
        }

        .bar .label {
            position: absolute;
            bottom: -25px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 10px;
            color: #888;
        }

        .bar .value {
            position: absolute;
            top: -20px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 10px;
            color: #4fc3f7;
        }

        /* Pie Chart */
        .pie-container {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .pie {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            position: relative;
        }

        .pie-legend {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
        }

        .legend-color {
            width: 12px;
            height: 12px;
            border-radius: 2px;
        }

        /* Tables */
        .table-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 20px;
        }

        .table-container {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .table-container h3 {
            font-size: 14px;
            color: #888;
            margin-bottom: 15px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 10px;
            text-align: left;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        th {
            font-size: 11px;
            color: #888;
            text-transform: uppercase;
        }

        td {
            font-size: 13px;
        }

        .status-badge {
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 500;
        }

        .status-completed { background: rgba(76, 175, 80, 0.2); color: #4caf50; }
        .status-active { background: rgba(79, 195, 247, 0.2); color: #4fc3f7; }
        .status-pending { background: rgba(255, 152, 0, 0.2); color: #ff9800; }
        .status-failed { background: rgba(244, 67, 54, 0.2); color: #f44336; }

        /* Actions */
        .actions {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        button {
            background: #4fc3f7;
            color: #1a1a2e;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        button:hover {
            background: #29b6f6;
            transform: translateY(-1px);
        }

        button.secondary {
            background: rgba(255, 255, 255, 0.1);
            color: #e0e0e0;
        }

        button.secondary:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        /* Loading */
        .loading {
            text-align: center;
            padding: 40px;
            color: #888;
        }

        .spinner {
            width: 40px;
            height: 40px;
            border: 3px solid rgba(255, 255, 255, 0.1);
            border-top-color: #4fc3f7;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 15px;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Alert */
        .alert {
            background: rgba(244, 67, 54, 0.1);
            border: 1px solid rgba(244, 67, 54, 0.3);
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .alert.warning {
            background: rgba(255, 152, 0, 0.1);
            border-color: rgba(255, 152, 0, 0.3);
        }

        .alert.success {
            background: rgba(76, 175, 80, 0.1);
            border-color: rgba(76, 175, 80, 0.3);
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>
            <span>Evolution Performance Dashboard</span>
        </h1>
        <div class="nav">
            <a href="../index.html">🏠 Hub</a>
            <a href="agent-dashboard.html">🤖 Agents</a>
            <a href="estimation-dashboard.html">📊 Estimation</a>
            <a href="quality-dashboard.html">✅ Quality</a>
            <a href="evolution-dashboard.html" class="active">🧬 Evolution</a>
            <a href="self-improvement-dashboard.html">🎓 Self-Improve</a>
        </div>
    </div>

    <div class="container">
        <!-- Actions -->
        <div class="actions">
            <button onclick="refreshData()">Refresh Data</button>
            <button class="secondary" onclick="autoTuneAll()">Auto-Tune All Agents</button>
            <button class="secondary" onclick="exportReport()">Export Report</button>
        </div>

        <!-- Alerts -->
        <div id="alerts"></div>

        <!-- Summary Cards -->
        <div class="summary-cards">
            <div class="summary-card">
                <div class="label">Overall Success Rate</div>
                <div class="value" id="success-rate">--</div>
                <div class="trend up" id="success-trend"></div>
            </div>
            <div class="summary-card">
                <div class="label">Estimation Accuracy</div>
                <div class="value" id="estimation-accuracy">--</div>
                <div class="trend" id="estimation-trend"></div>
            </div>
            <div class="summary-card">
                <div class="label">Learning Progress</div>
                <div class="value" id="learning-progress">--</div>
                <div class="trend" id="learning-trend"></div>
            </div>
            <div class="summary-card">
                <div class="label">Active Sessions</div>
                <div class="value" id="active-sessions">--</div>
                <div class="trend stable" id="sessions-info"></div>
            </div>
        </div>

        <!-- Agent Evolution Grid -->
        <h2 style="margin-bottom: 15px; font-size: 16px; color: #888;">Agent Evolution Status</h2>
        <div class="agent-grid" id="agent-grid">
            <!-- Agents populated by JS -->
        </div>

        <!-- Charts -->
        <div class="charts-section">
            <div class="chart-container">
                <h3>Learning Progress Over Time</h3>
                <div class="chart" id="progress-chart">
                    <!-- Bars populated by JS -->
                </div>
            </div>
            <div class="chart-container">
                <h3>Experience Distribution</h3>
                <div class="pie-container">
                    <div class="pie" id="experience-pie"></div>
                    <div class="pie-legend" id="pie-legend">
                        <!-- Legend populated by JS -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Tables -->
        <div class="table-section">
            <div class="table-container">
                <h3>Recent Learning Sessions</h3>
                <table>
                    <thead>
                        <tr>
                            <th>Agent</th>
                            <th>Status</th>
                            <th>Improvements</th>
                            <th>Duration</th>
                        </tr>
                    </thead>
                    <tbody id="sessions-table">
                        <!-- Rows populated by JS -->
                    </tbody>
                </table>
            </div>
            <div class="table-container">
                <h3>Rollback History</h3>
                <table>
                    <thead>
                        <tr>
                            <th>Agent</th>
                            <th>Reason</th>
                            <th>Timestamp</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="rollback-table">
                        <!-- Rows populated by JS -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        const API_BASE = 'http://localhost:8000/api';

        const AGENTS = [
            { id: 'felix', name: 'Felix', role: 'Feature Architect' },
            { id: 'marcus', name: 'Marcus', role: 'Maintenance Specialist' },
            { id: 'quinn', name: 'Quinn', role: 'Quality Inspector' },
            { id: 'betty', name: 'Betty', role: 'Bug Hunter' },
            { id: 'eliza', name: 'Eliza', role: 'Estimation Engine' },
            { id: 'tessa', name: 'Tessa', role: 'Test Engineer' },
            { id: 'miguel', name: 'Miguel', role: 'Migration Architect' },
            { id: 'diana', name: 'Diana', role: 'Documentation Writer' },
            { id: 'peter', name: 'Peter', role: 'Product Owner' },
            { id: 'paul', name: 'Paul', role: 'Project Lead' }
        ];

        let selectedAgent = null;

        // Initialize dashboard
        async function initDashboard() {
            renderAgentGrid();
            await refreshData();
        }

        // Render agent grid
        function renderAgentGrid() {
            const grid = document.getElementById('agent-grid');
            grid.innerHTML = AGENTS.map(agent => `
                <div class="agent-card" id="agent-${agent.id}" onclick="selectAgent('${agent.id}')">
                    <div class="name">${agent.name}</div>
                    <div class="role">${agent.role}</div>
                    <div class="improvement neutral" id="improvement-${agent.id}">--</div>
                </div>
            `).join('');
        }

        // Select agent for detailed view
        function selectAgent(agentId) {
            // Toggle selection
            if (selectedAgent === agentId) {
                selectedAgent = null;
                document.querySelectorAll('.agent-card').forEach(card => {
                    card.classList.remove('selected');
                });
            } else {
                selectedAgent = agentId;
                document.querySelectorAll('.agent-card').forEach(card => {
                    card.classList.remove('selected');
                });
                document.getElementById(`agent-${agentId}`).classList.add('selected');
                loadAgentDetails(agentId);
            }
        }

        // Load agent details
        async function loadAgentDetails(agentId) {
            try {
                const response = await fetch(`${API_BASE}/continuous-learning/status/${agentId}`);
                const data = await response.json();
                console.log('Agent details:', data);
            } catch (error) {
                console.error('Error loading agent details:', error);
            }
        }

        // Refresh all data
        async function refreshData() {
            try {
                // Load metrics
                await loadMetrics();

                // Load sessions
                await loadSessions();

                // Load agent improvements
                await loadAgentImprovements();

                // Update charts
                updateCharts();
            } catch (error) {
                console.error('Error refreshing data:', error);
                showAlert('Failed to load data. Please check the API connection.', 'error');
            }
        }

        // Load overall metrics
        async function loadMetrics() {
            try {
                const response = await fetch(`${API_BASE}/continuous-learning/metrics`);
                const metrics = await response.json();

                // Calculate averages
                if (metrics.length > 0) {
                    const avgSessions = metrics.reduce((sum, m) => sum + m.total_sessions, 0) / metrics.length;
                    const avgImprovement = metrics.reduce((sum, m) => sum + m.total_improvements, 0) / metrics.length;

                    document.getElementById('learning-progress').textContent = `${(avgImprovement * 100).toFixed(0)}%`;
                    document.getElementById('learning-trend').textContent = avgImprovement > 0 ? 'Improving' : 'Stable';
                    document.getElementById('learning-trend').className = `trend ${avgImprovement > 0 ? 'up' : 'stable'}`;
                }

                // Mock data for demo
                document.getElementById('success-rate').textContent = '78%';
                document.getElementById('success-trend').textContent = '+5% vs last week';
                document.getElementById('estimation-accuracy').textContent = '82%';
                document.getElementById('estimation-trend').textContent = '+3% improvement';
                document.getElementById('estimation-trend').className = 'trend up';
                document.getElementById('active-sessions').textContent = metrics.length || '0';
                document.getElementById('sessions-info').textContent = `${metrics.length} agents active`;
            } catch (error) {
                console.error('Error loading metrics:', error);
            }
        }

        // Load learning sessions
        async function loadSessions() {
            try {
                const response = await fetch(`${API_BASE}/continuous-learning/sessions?limit=5`);
                const data = await response.json();

                const table = document.getElementById('sessions-table');

                if (data.sessions && data.sessions.length > 0) {
                    table.innerHTML = data.sessions.map(session => `
                        <tr>
                            <td>${session.agent_id}</td>
                            <td><span class="status-badge status-${session.status}">${session.status}</span></td>
                            <td>${session.threshold_updates?.length || 0}</td>
                            <td>${formatDuration(session.started_at, session.ended_at)}</td>
                        </tr>
                    `).join('');
                } else {
                    // Demo data
                    table.innerHTML = `
                        <tr>
                            <td>Felix</td>
                            <td><span class="status-badge status-completed">completed</span></td>
                            <td>3</td>
                            <td>2m 15s</td>
                        </tr>
                        <tr>
                            <td>Quinn</td>
                            <td><span class="status-badge status-active">active</span></td>
                            <td>1</td>
                            <td>45s</td>
                        </tr>
                        <tr>
                            <td>Betty</td>
                            <td><span class="status-badge status-completed">completed</span></td>
                            <td>2</td>
                            <td>1m 30s</td>
                        </tr>
                    `;
                }
            } catch (error) {
                console.error('Error loading sessions:', error);
            }
        }

        // Load agent improvements
        async function loadAgentImprovements() {
            // Demo data for each agent
            const improvements = {
                felix: 15, marcus: 12, quinn: 18, betty: 10, eliza: 22,
                tessa: 8, miguel: 14, diana: 6, peter: 11, paul: 9
            };

            for (const [agentId, improvement] of Object.entries(improvements)) {
                const el = document.getElementById(`improvement-${agentId}`);
                if (el) {
                    el.textContent = `${improvement > 0 ? '+' : ''}${improvement}%`;
                    el.className = `improvement ${improvement > 0 ? 'positive' : improvement < 0 ? 'negative' : 'neutral'}`;
                }
            }
        }

        // Update charts
        function updateCharts() {
            // Progress chart (bar chart)
            const progressData = [65, 72, 68, 75, 78, 82, 85];
            const labels = ['W1', 'W2', 'W3', 'W4', 'W5', 'W6', 'W7'];
            const maxValue = Math.max(...progressData);

            const chart = document.getElementById('progress-chart');
            chart.innerHTML = progressData.map((value, i) => `
                <div class="bar" style="height: ${(value / maxValue) * 180}px">
                    <span class="value">${value}%</span>
                    <span class="label">${labels[i]}</span>
                </div>
            `).join('');

            // Pie chart
            const pieData = [
                { label: 'Success', value: 65, color: '#4caf50' },
                { label: 'Partial', value: 25, color: '#ff9800' },
                { label: 'Failed', value: 10, color: '#f44336' }
            ];

            const pie = document.getElementById('experience-pie');
            let cumulativePercent = 0;
            const gradientStops = pieData.map(item => {
                const start = cumulativePercent;
                cumulativePercent += item.value;
                return `${item.color} ${start}% ${cumulativePercent}%`;
            });

            pie.style.background = `conic-gradient(${gradientStops.join(', ')})`;

            // Legend
            const legend = document.getElementById('pie-legend');
            legend.innerHTML = pieData.map(item => `
                <div class="legend-item">
                    <div class="legend-color" style="background: ${item.color}"></div>
                    <span>${item.label}: ${item.value}%</span>
                </div>
            `).join('');

            // Rollback table (demo data)
            const rollbackTable = document.getElementById('rollback-table');
            rollbackTable.innerHTML = `
                <tr>
                    <td>Marcus</td>
                    <td>Quality drop > 15%</td>
                    <td>2h ago</td>
                    <td><span class="status-badge status-completed">recovered</span></td>
                </tr>
                <tr>
                    <td>Eliza</td>
                    <td>Estimation error increase</td>
                    <td>1d ago</td>
                    <td><span class="status-badge status-completed">recovered</span></td>
                </tr>
            `;
        }

        // Auto-tune all agents
        async function autoTuneAll() {
            showAlert('Starting auto-tune for all agents...', 'info');

            try {
                const response = await fetch(`${API_BASE}/continuous-learning/auto-tune`, {
                    method: 'POST'
                });
                const result = await response.json();

                showAlert(`Auto-tune complete: ${result.agents_tuned} agents tuned, ${result.agents_skipped} skipped`, 'success');
                await refreshData();
            } catch (error) {
                showAlert('Auto-tune failed. Please try again.', 'error');
            }
        }

        // Export report
        function exportReport() {
            const report = {
                timestamp: new Date().toISOString(),
                agents: AGENTS,
                summary: {
                    successRate: document.getElementById('success-rate').textContent,
                    estimationAccuracy: document.getElementById('estimation-accuracy').textContent,
                    learningProgress: document.getElementById('learning-progress').textContent
                }
            };

            const blob = new Blob([JSON.stringify(report, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `evolution-report-${new Date().toISOString().split('T')[0]}.json`;
            a.click();
        }

        // Show alert
        function showAlert(message, type = 'info') {
            const alerts = document.getElementById('alerts');
            const alert = document.createElement('div');
            alert.className = `alert ${type === 'success' ? 'success' : type === 'error' ? '' : 'warning'}`;
            alert.textContent = message;
            alerts.appendChild(alert);

            setTimeout(() => alert.remove(), 5000);
        }

        // Format duration
        function formatDuration(start, end) {
            if (!start) return '--';
            const startDate = new Date(start);
            const endDate = end ? new Date(end) : new Date();
            const diff = Math.floor((endDate - startDate) / 1000);

            if (diff < 60) return `${diff}s`;
            if (diff < 3600) return `${Math.floor(diff / 60)}m ${diff % 60}s`;
            return `${Math.floor(diff / 3600)}h ${Math.floor((diff % 3600) / 60)}m`;
        }

        // Initialize on load
        initDashboard();
    </script>
</body>
</html>

# MarQed.ai Client Portal - Environment Configuration

# Application
APP_NAME=MarQed.ai Client Portal
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marqed_portal

# Security - CHANGE IN PRODUCTION!
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Multi-tenant
DEFAULT_TENANT_SUBDOMAIN=app
TENANT_HEADER_NAME=X-Tenant-ID

# Redis
REDIS_URL=redis://localhost:6379/1

# Email (SendGrid)
SENDGRID_API_KEY=
FROM_EMAIL=noreply@marqed.ai

# Main Backend Integration
MAIN_BACKEND_URL=http://localhost:8000
MAIN_BACKEND_API_KEY=

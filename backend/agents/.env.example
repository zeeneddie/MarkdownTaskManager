# KaibanJS Agent System - Environment Configuration

# Anthropic Claude API (for Feature Architect & Quality Inspector)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API (for Migration Architect)
OPENAI_API_KEY=your-openai-api-key-here

# Ollama (for local agents: Maintenance, Bug Hunter, Estimation, Test, Documentation)
OLLAMA_BASE_URL=http://localhost:11434

# Note: Make sure Ollama is installed and running locally with llama3.1:8b model
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Run: ollama run llama3.1:8b

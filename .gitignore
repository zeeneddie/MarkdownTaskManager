# ============================================
# MarQed AI Agent Platform - .gitignore
# Version: 2.0.0 (Restructure Week 145)
# ============================================

# ===========================================
# PYTHON RUNTIME & CACHE
# ===========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
*.egg
dist/
build/
.eggs/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Type checking & linting
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.nox/
.tox/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# ===========================================
# NODE.JS
# ===========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn
.pnp.*
*.tsbuildinfo

# TypeScript build output
src/agents/dist/
*.js.map
*.d.ts
!src/agents/types/*.d.ts

# ===========================================
# ENVIRONMENT & SECRETS
# ===========================================
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
!config/environments/.env.example

# Secrets & credentials
*.pem
*.key
*.crt
*.p12
secrets/
credentials/
.secrets/

# ===========================================
# IDE & EDITORS
# ===========================================
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.code-workspace

# ===========================================
# OS SPECIFIC
# ===========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ===========================================
# LOGS & TEMPORARY FILES
# ===========================================
*.log
logs/
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej

# ===========================================
# DATABASE & DATA FILES
# ===========================================
*.db
*.sqlite
*.sqlite3
chromadb_data/
*.dump
*.sql.gz
*.sql.bz2

# ===========================================
# ML MODELS (Keep only latest/ symlinks)
# ===========================================
src/backend/ml_models/*/*/
!src/backend/ml_models/*/latest/
backend/ml_models/*/*/
!backend/ml_models/*/latest/

# ===========================================
# MCP TOOL CACHES (Large, regenerable)
# ===========================================
# Serena
.serena/cache/
.serena/memories/
.mcp/serena/cache/
.mcp/serena/memories/

# Playwright
.playwright-mcp/screenshots/
.playwright-mcp/*.png
.mcp/playwright/screenshots/
.mcp/playwright/*.png
!.playwright-mcp/README.md

# ChromaDB persistence
.mcp/*/chromadb/

# ===========================================
# BUILD & RUNTIME ARTIFACTS
# ===========================================
*.pid
.pids/
*.sock
*.socket
.states/
.hypotheses/
.memory/
.agent_memory/
.mtm_transform_backups/
screenshots/

# Docker
docker-compose.override.yml

# ===========================================
# DOCUMENTATION BUILD
# ===========================================
site/
_build/
.docusaurus/
docs/_build/

# ===========================================

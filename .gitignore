# ===========================================
test-results/
playwright-report/
allure-results/
allure-report/
*.test.log
.test-output/

# ===========================================
# LARGE FILES (Prevent accidental commit)
# ===========================================
*.tar.gz
*.tar.bz2
*.zip
*.7z
*.rar
*.iso
*.dmg

# Large media
*.mp4
*.avi
*.mov
*.mkv
*.mp3
*.wav

# ===========================================
# PROJECT SPECIFIC
# ===========================================
# ChromaDB data
chromadb_data/
backend/chromadb_data/

# ML training outputs
training_output/
model_checkpoints/

# Export files
exports/
*.csv.gz
*.jsonl.gz

# Temporary test projects
test-project/
test-frontend-project/

